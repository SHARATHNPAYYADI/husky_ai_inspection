<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <Sequence>

      <WaitForMissionGoalBT
          goal="{goal}"
          goal_name="{goal_name}"
          mission_id="{mission_id}"
          poses="{poses}"
          goal_names="{goal_names}"
          index="{index}" />

      <SequenceStar>

        <NavigateToPoseBT
            goal="{goal}"
            mission_id="{mission_id}" />

        <InspectFireExtinguisherBT
            goal_name="{goal_name}" />

        <NextWaypointBT
            poses="{poses}"
            goal_names="{goal_names}"
            index="{index}"
            goal="{goal}"
            goal_name="{goal_name}" />

      </SequenceStar>

    </Sequence>

  </BehaviorTree>
</root>