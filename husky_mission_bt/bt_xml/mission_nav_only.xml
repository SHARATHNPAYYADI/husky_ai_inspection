<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <Sequence>

      <!-- Wait for mission to arrive -->
      <WaitForMissionGoalBT
          goal="{goal}"
          goal_name="{goal_name}"
          mission_id="{mission_id}"
          poses="{poses}"
          goal_names="{goal_names}"
          index="{index}" />

      <!-- LOOP: re-checks HasMoreWaypoints every tick -->
      <ReactiveSequence>

        <!-- Condition: keeps returning SUCCESS while waypoints remain -->
        <HasMoreWaypoints
            index="{index}"
            poses="{poses}" />

        <!-- Body: advance index, navigate, inspect -->
        <Sequence>

          <NextWaypointBT
              goal_names="{goal_names}"
              poses="{poses}"
              index="{index}"
              goal="{goal}"
              goal_name="{goal_name}" />

          <NavigateToPoseBT
              goal="{goal}"
              mission_id="{mission_id}" />

          <InspectFireExtinguisherBT
              goal_name="{goal_name}"
              present="{present}"
              confidence="{confidence}"
              image_path="{image_path}"
              annotated_path="{annotated_path}" />

        </Sequence>

      </ReactiveSequence>

    </Sequence>

  </BehaviorTree>
</root>