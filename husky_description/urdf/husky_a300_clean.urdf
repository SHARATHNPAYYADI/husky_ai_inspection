<robot name="husky">
  <!-- robot name parameter -->
  <!-- <xacro:arg name="name" default="" /> -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="medium_grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="light_grey">
